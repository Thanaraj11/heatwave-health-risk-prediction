# Build stage
FROM node:18-alpine AS build

WORKDIR /app

COPY frontend/package*.json ./
# Install all dependencies including devDependencies required for building React
RUN npm ci

COPY frontend/ ./

# Pass ARG and ENV to the build stage where React builds it into static files
ARG REACT_APP_API_URL
ENV REACT_APP_API_URL=$REACT_APP_API_URL

RUN npm run build

# Production stage with nginx
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]